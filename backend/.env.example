# ── LLM Provider ──────────────────────────────────────────────
# Choose one: gemini | openai | grok | ollama | openai_compatible
LLM_PROVIDER=gemini

# ── Gemini (Google)  -  RECOMMENDED (free tier, no credit card) ──
# Get a free API key at https://ai.google.dev
# Free tier: ~250 requests/day (Flash), ~1000/day (Flash-Lite)
# Context window: 1M tokens  -  fits the entire rulebook!
GEMINI_API_KEY=your-gemini-api-key-here
# Models: gemini-2.5-flash (recommended), gemini-2.5-flash-lite (more RPD), gemini-2.0-flash
# If your free quota allows it, you can try a stronger model.
LLM_MODEL=gemini-2.5-flash

# ── OpenAI ──
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# ── Grok (xAI) ──
# Get key at https://console.x.ai
# XAI_API_KEY=xai-your-key-here
# LLM_MODEL=grok-4-1-fast-non-reasoning

# ── Ollama / OpenAI-compatible (local) ──
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# ── LLM Tuning ──
# Lower = stick to rulebook (less hallucination). Default 0.2.
# LLM_TEMPERATURE=0.2
# Optional: top_p (leave unset to use API default)
# LLM_TOP_P=
# Max reply tokens returned by the model (higher = fuller answers, higher cost/latency)
# LLM_MAX_TOKENS=6144

# ── GM Response Logging (optional, for bias/canon auditing) ──
LOG_GM_RESPONSES=false
LOG_GM_RESPONSE_PREFIX_LEN=200

# ── RAG ──
# RAG_SOURCE_DIR=reference/TTRPG_DRD
FAISS_PATH=./faiss_drd
# Set to 1 to force RAG index rebuild (e.g. after changing source MDs/CSVs)
RAG_FORCE_REBUILD=
RAG_TOP_K=20
# Use MMR retrieval to diversify retrieved chunks and reduce near-duplicate passages
RAG_USE_MMR=true
# Candidate pool size used by MMR (larger can improve recall at extra latency)
# RAG_FETCH_K=80

# ── Outpost newsletter (optional) ──
# The site POSTs to POST /newsletter/subscribe on this API. Choose ONE backend:
#
# A) Google Apps Script: deploy a Web App that appends rows to your sheet; paste its URL:
# NEWSLETTER_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
#
# B) Google Sheets API: create a service account (GCP), enable Sheets API, share the spreadsheet
#    with the service account email, paste the full JSON key in one line (or use Render multiline secret):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# NEWSLETTER_SPREADSHEET_ID=1u2pA0CqJUvbPF2idU0OXt4TZZ1HbZDLQqRQX4VWMsXI
# Optional A1 range for append (default appends columns A–D: timestamp, email, lang, source):
# NEWSLETTER_SHEET_RANGE=Sheet1!A:D

# ── CORS ──
CORS_WILDCARD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:5500,https://www.thediscordingtales.com,https://thediscordingtales.com
