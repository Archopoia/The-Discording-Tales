# ── LLM Provider ──────────────────────────────────────────────
# Choose one: gemini | openai | grok | ollama | openai_compatible
LLM_PROVIDER=gemini

# ── Gemini (Google) — RECOMMENDED (free tier, no credit card) ──
# Get a free API key at https://ai.google.dev
# Free tier: ~250 requests/day (Flash), ~1000/day (Flash-Lite)
# Context window: 1M tokens — fits the entire rulebook!
GEMINI_API_KEY=your-gemini-api-key-here
# Models: gemini-2.5-flash (recommended), gemini-2.5-flash-lite (more RPD), gemini-2.0-flash
LLM_MODEL=gemini-2.5-flash

# ── OpenAI ──
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# ── Grok (xAI) ──
# Get key at https://console.x.ai
# XAI_API_KEY=xai-your-key-here
# LLM_MODEL=grok-4-1-fast-non-reasoning

# ── Ollama / OpenAI-compatible (local) ──
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# ── LLM Tuning ──
# Lower = stick to rulebook (less hallucination). Default 0.3.
# LLM_TEMPERATURE=0.3
# Optional: top_p (leave unset to use API default)
# LLM_TOP_P=

# ── GM Response Logging (optional, for bias/canon auditing) ──
LOG_GM_RESPONSES=false
LOG_GM_RESPONSE_PREFIX_LEN=200

# ── RAG ──
# RAG_SOURCE_DIR=reference/TTRPG_DRD
FAISS_PATH=./faiss_drd
# Set to 1 to force RAG index rebuild (e.g. after changing source MDs/CSVs)
RAG_FORCE_REBUILD=
RAG_TOP_K=12

# ── CORS ──
CORS_WILDCARD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:5500
